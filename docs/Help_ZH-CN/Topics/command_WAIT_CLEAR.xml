<topic template="Default" modified="2026-11-17T13:30:54.679+01:00" lasteditedby="robert" version="2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../helpproject.xsd">
  <title>WAIT CLEAR 命令</title>
  <keywords>
    <keyword>Commands</keyword>
    <keyword>Terminal</keyword>
    <keyword>WAIT CLEAR command</keyword>
  </keywords>
  <body>
    <header>
      <para styleclass="Heading1">WAIT CLEAR 命令</para>
    </header>
    <para styleclass="Normal"><snippet src="__FoxProOnly" inline="false"/></para>
    <para styleclass="Normal"><snippet src="__CommandInclude" inline="false"/></para>
    <para styleclass="Heading1">用途</para>
    <para styleclass="Normal">关闭由 <link displaytype="text" defaultstyle="true" type="topiclink" href="command_WAIT_FoxPro">WAIT WINDOW ... NOCLEAR</link> 命令保持打开的消息窗口。</para>
    <para styleclass="Heading1">语法</para>
    <para styleclass="Code with box">WAIT CLEAR</para>
    <para styleclass="Heading1">备注</para>
    <para styleclass="Normal"><text styleclass="Body Text" style="font-weight:bold; color:#ff0000;">目前不支持</text>：该命令为了兼容性而被接受，但不执行任何操作。</para>
    <para styleclass="Body Text"><snippet src="__IncludeLibVFP" inline="false"/></para>
    <para styleclass="Heading1">参见</para>
    <para styleclass="Normal"><link displaytype="text" defaultstyle="true" type="topiclink" href="command_WAIT_FoxPro">WAIT (FoxPro)</link>, <link displaytype="text" defaultstyle="true" type="topiclink" href="command_WAIT">WAIT</link></para>
  </body>
</topic>
