<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>BinaryTest</RootNamespace>
    <TargetFramework>net472</TargetFramework>
    <Name>TestBed</Name>
    <Dialect>FoxPro</Dialect>
    <az>false</az>
    <ins>true</ins>
    <unsafe>true</unsafe>
    <vo2>true</vo2>
    <vo3>true</vo3>
    <vo4>true</vo4>
    <vo5>true</vo5>
    <vo6>true</vo6>
    <vo7>true</vo7>
    <vo9>true</vo9>
    <vo10>true</vo10>
    <vo13>true</vo13>
    <vo14>true</vo14>
    <vo15>true</vo15>
    <vo16>true</vo16>
    <lb>true</lb>
    <memvar>true</memvar>
    <undeclared>false</undeclared>
    <initlocals>true</initlocals>
    <fox1>true</fox1>
    <fox2>true</fox2>
    <VO1>false</VO1>
    <VO8>false</VO8>
    <VO11>false</VO11>
    <VO12>false</VO12>
    <NamedArgs>False</NamedArgs>
    <VulcanCompatibleResources>False</VulcanCompatibleResources>
    <NoWin32Manifest>False</NoWin32Manifest>
    <CS>false</CS>
    <OVF>false</OVF>
    <NS>false</NS>
    <NoStandardDefs>false</NoStandardDefs>
    <Allowdot>true</Allowdot>
    <AllowOldStyleAssignments>true</AllowOldStyleAssignments>
    <AssemblyName>BinaryTest</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Runtime\MacroCompiler\XSharp.MacroCompiler.csproj" />
    <ProjectReference Include="..\..\Runtime\XSharp.Core\XSharp.Core.xsproj" />
    <ProjectReference Include="..\..\Runtime\XSharp.Rdd\XSharp.RDD.xsproj" />
    <ProjectReference Include="..\..\Runtime\XSharp.RT\XSharp.RT.xsproj" />
    <ProjectReference Include="..\..\Runtime\XSharp.VFP\XSharp.VFP.xsproj" />
    <ProjectReference Include="..\..\Runtime\XSharp.XPP\XSharp.XPP.xsproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
</Project>