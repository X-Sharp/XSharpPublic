<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Runtime.Sdk.Props" />
  <PropertyGroup>
    <RootNamespace>XSharp.VFP.UI</RootNamespace>
    <AssemblyName>XSharp.VFP.UI</AssemblyName>
    <Name>XSharp.VFP.UI</Name>
    <Dialect>XBaseNet</Dialect>
    <ins>true</ins>
    <vo2>true</vo2>
    <vo3>true</vo3>
    <vo4>true</vo4>
    <vo9>true</vo9>
    <vo10>true</vo10>
    <InitLocals>True</InitLocals>
    <AllowOldStyleAssignments>False</AllowOldStyleAssignments>
    <NoWarn>$(NoWarn);$(DisabledWarnings);108,114</NoWarn>
    <TargetFrameworks>net47;net8.0-windows</TargetFrameworks>
    <IncludePaths>$(IncludePaths);$(ProjectDir)..\XSharp.VFP;$(ProjectDir)\Headers</IncludePaths>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="AutoCloseMessageBox.prg" />
    <Compile Remove="FoxProClassMembers\dumpMembers.PRG" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\XSharp.Core\XSharp.Core.xsproj" />
    <ProjectReference Include="..\XSharp.Data\XSharp.Data.xsproj" />
    <ProjectReference Include="..\XSharp.RT\XSharp.RT.xsproj" />
    <ProjectReference Include="..\XSharp.VFP\XSharp.VFP.xsproj" />
  </ItemGroup>
  <Import Project="..\XmlDoc.Props" />
</Project>