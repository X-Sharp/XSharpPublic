<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Name>XsLegacyConverter</Name>
    <TargetFramework>net47</TargetFramework>
    <RootNamespace>XsLegacyConverter</RootNamespace>
    <IncludePaths>$(Solutiondir)Common</IncludePaths>
    <CommonDir>..\..\Common\</CommonDir>
    <NoStandardDefs>True</NoStandardDefs>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(CommonDir)commonAssemblyInfo.prg">
      <Link>Properties\commonAssemblyInfo.prg</Link>
    </Compile>
    <Compile Include="$(CommonDir)constants.prg">
      <Link>Properties\constants.prg</Link>
    </Compile>
  </ItemGroup>
</Project>