<!--
***********************************************************************************************
XSharp.DesignTime.Targets

WARNING:  DO NOT MODIFY this file unless you are knowledgeable about MSBuild and have
          created a backup copy.  Incorrect changes to this file will make it
          impossible to load or build your projects from the command-line or the IDE.

  This file contains Visual Studio and designer-related properties and items for X# projects
  that are loaded by the CPS based X# project system (XSharp.ProjectSystemCPS).
  It is based on Microsoft.CSharp.DesignTime.targets.

  It is imported by XSharp.CurrentVersion.targets and XSharp.CrossTargeting.targets, but only when
  the property XSharpCpsProjectSystem is 'true'. The CPS project type sets that property as a global
  property, so projects loaded by the MPFproj project system and command line builds are not affected.

  It imports Microsoft.Managed.DesignTime.targets from the Visual Studio installation
  (<VisualStudio>\MSBuild\Microsoft\VisualStudio\Managed). That file declares the managed capabilities
  (.NET, DependenciesTree, PackageReferences, ...) and the property page rules of the managed project system.
  X# specific rules live in the Rules subfolder of this folder.

Copyright (c) XSharp B.V.  All Rights Reserved

inspired by Microsoft.CSharp.DesignTime.targets
***********************************************************************************************
-->

<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <XSharpManagedDesignTimeTargetsPath Condition="'$(XSharpManagedDesignTimeTargetsPath)' == ''">$(MSBuildExtensionsPath)\Microsoft\VisualStudio\Managed\Microsoft.Managed.DesignTime.targets</XSharpManagedDesignTimeTargetsPath>
    <XSharpXamlDir Condition="'$(XSharpXamlDir)' == ''">$(MSBuildThisFileDirectory)Rules\</XSharpXamlDir>
  </PropertyGroup>

  <Import Project="$(XSharpManagedDesignTimeTargetsPath)" />

  <!-- Properties -->
  <PropertyGroup>
    <AppDesignerFolder Condition="'$(AppDesignerFolder)' == ''">Properties</AppDesignerFolder>
    <AppDesignerFolderContentsVisibleOnlyInShowAllFiles Condition="'$(AppDesignerFolderContentsVisibleOnlyInShowAllFiles)' == ''">false</AppDesignerFolderContentsVisibleOnlyInShowAllFiles>
    <LanguageServiceName Condition="'$(LanguageServiceName)' == ''">X#</LanguageServiceName>
    <!-- XSharpConstants.guidXSharpLanguageServicePkgString -->
    <LanguageServiceId Condition="'$(LanguageServiceId)'==''">{E9B6EE0F-9BFA-4CFF-A60B-51A08BBC5050}</LanguageServiceId>
    <TemplateLanguage Condition="'$(TemplateLanguage)' == ''">XSharp</TemplateLanguage>
    <!--
      X# project factory GUID (XSharpConstants.guidXSharpProjectFactoryString): the X# item templates
      (Projects\{AA6C8D78-...}\AddItemTemplates) and single file generators (Generators\{AA6C8D78-...})
      are registered there by the X# project package. The C# values would show the C# item templates.
    -->
    <AddItemTemplatesGuid Condition="'$(AddItemTemplatesGuid)' == ''">{AA6C8D78-22FF-423A-9C7C-5F2393824E04}</AddItemTemplatesGuid>
    <CmdUIContextGuid Condition="'$(CmdUIContextGuid)' == ''">{AA6C8D78-22FF-423A-9C7C-5F2393824E04}</CmdUIContextGuid>
    <GeneratorsTypeGuid Condition="'$(GeneratorsTypeGuid)' == ''">{AA6C8D78-22FF-423A-9C7C-5F2393824E04}</GeneratorsTypeGuid>
    <DesignerFunctionVisibility Condition="'$(DesignerFunctionVisibility)' == ''">Private</DesignerFunctionVisibility>
    <DesignerVariableNaming Condition="'$(DesignerVariableNaming)' == ''">Camel</DesignerVariableNaming>
    <DesignerHiddenCodeGeneration Condition="'$(DesignerHiddenCodeGeneration)' == ''">Declarations</DesignerHiddenCodeGeneration>
    <!--
      XSharpCpsProjectSystem is a global property of this project only (set by the CPS project type). Do not pass it
      to referenced projects: C# and legacy X# projects would be evaluated and built a second time with different
      global properties (overbuild, file locks), and a referenced X# project would import these design-time targets
      in a normal build. The MSBuild task calls in Microsoft.Common.CurrentVersion.targets append this list directly
      to %(GlobalPropertiesToRemove), so it must start with a semicolon.
    -->
    <_GlobalPropertiesToRemoveFromProjectReferences>$(_GlobalPropertiesToRemoveFromProjectReferences);XSharpCpsProjectSystem</_GlobalPropertiesToRemoveFromProjectReferences>
  </PropertyGroup>

  <ItemGroup>
    <PropertyPageSchema Include="$(XSharpXamlDir)ProjectItemsSchema.XSharp.xaml" />
    <!--
      X# project property pages (new property editor, capability ProjectPropertiesEditor).
      Language, Dialect and Global Usings are X# pages; Application and Build extend the managed pages
      (OverrideMode="Extend"). The property names match what the X# targets (Xsc task) and MPFproj persist.
    -->
    <PropertyPageSchema Include="$(XSharpXamlDir)ApplicationPropertyPage.XSharp.xaml;$(XSharpXamlDir)BuildPropertyPage.XSharp.xaml;$(XSharpXamlDir)LanguagePage.XSharp.xaml;$(XSharpXamlDir)DialectPage.XSharp.xaml;$(XSharpXamlDir)ReferencesPage.XSharp.xaml">
      <Context>Project</Context>
    </PropertyPageSchema>
    <!-- X# item types: file properties and Properties window -->
    <PropertyPageSchema Include="$(XSharpXamlDir)NativeResource.xaml;$(XSharpXamlDir)VOBinary.xaml">
      <Context>File</Context>
    </PropertyPageSchema>
    <PropertyPageSchema Include="$(XSharpXamlDir)NativeResource.BrowseObject.xaml;$(XSharpXamlDir)VOBinary.BrowseObject.xaml">
      <Context>BrowseObject</Context>
    </PropertyPageSchema>
    <!-- Data for XSharpProjectAdapter (code model), invisible -->
    <PropertyPageSchema Include="$(XSharpXamlDir)XSharpCompilerCommandLineArgs.xaml;$(XSharpXamlDir)XSharpProjectProperties.xaml">
      <Context>ProjectSubscriptionService</Context>
    </PropertyPageSchema>
    <ProjectCapability Include="
                          XSharp;
                          Managed;
                          SingleTargetBuildForStartupProjects;
                          ProjectPropertiesEditor;" />
    <!--
      The managed project system hooks up the Roslyn workspace for ".NET & LanguageService" projects.
      X# has its own language service and code model, so LanguageService must not be declared.
      ReferencesFolder is replaced by the Dependencies tree (DependenciesTree capability).
    -->
    <ProjectCapability Remove="LanguageService;ReferencesFolder" />
  </ItemGroup>

  <!-- Targets -->

  <!--
      Returns Xsc command-line arguments for the language service
	  The _CheckCompileDesignTimePrerequisite target checks to make sure that
	  both SkipCompilerExecution and ProvideCommandLineArgs are set to true.
	  When that happens, then the xsc task will create items for each of the command-line arguments
	  and will not execute xsc.exe
	  These items are picked up by the managed project system and fed to the language service.
  -->
  <Target Name="CompileDesignTime"
          Returns="@(_CompilerCommandLineArgs)"
          DependsOnTargets="_CheckCompileDesignTimePrerequisite;Compile"
          Condition="'$(IsCrossTargetingBuild)' != 'true'">

    <ItemGroup>
      <_CompilerCommandLineArgs Include="@(XscCommandLineArgs)" />
    </ItemGroup>

  </Target>

</Project>