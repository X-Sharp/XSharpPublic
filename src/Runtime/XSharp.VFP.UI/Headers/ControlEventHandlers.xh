PRIVATE _VFPMouseWheel AS VFPOverride
/// <summary>
/// Name of the VFP method called when the mouse wheel is rotated over the control. Passes nButton, nShift, nXCoord, nYCoord, nDelta.
/// </summary>
[System.ComponentModel.Category("VFP Events"),System.ComponentModel.Description("MouseWheel")];
[System.ComponentModel.DefaultValue(NULL)];
PROPERTY vfpMouseWheel AS STRING GET _VFPMouseWheel?:SendTo SET Set_MouseWheel( VFPOverride{SELF, VALUE} )

METHOD Set_MouseWheel( methodCall AS VFPOverride ) AS VOID
	SUPER:MouseWheel += System.Windows.Forms.MouseEventHandler{ SELF, @OnVFPMouseWheel() }
	SELF:_VFPMouseWheel := methodCall

PRIVATE METHOD OnVFPMouseWheel(sender AS OBJECT, e AS System.Windows.Forms.MouseEventArgs) AS VOID
	IF _VFPMouseWheel != NULL
		LOCAL nButton AS INT
		LOCAL nShift  AS INT
		SWITCH e:Button
		CASE MouseButtons.Right  ; nButton := 2
		CASE MouseButtons.Middle ; nButton := 4
		OTHERWISE                ; nButton := 1
		END SWITCH
		nShift := 0
		IF ( System.Windows.Forms.Control.ModifierKeys & Keys.Shift )   == Keys.Shift   ; nShift += 1 ; ENDIF
		IF ( System.Windows.Forms.Control.ModifierKeys & Keys.Control ) == Keys.Control ; nShift += 2 ; ENDIF
		IF ( System.Windows.Forms.Control.ModifierKeys & Keys.Alt )     == Keys.Alt     ; nShift += 4 ; ENDIF
		SELF:__aeventsData := AEventsDefinition{ sender, "MouseWheel" }
		SELF:_VFPMouseWheel:Call( <USUAL>{nButton, nShift, e:X, e:Y, e:Delta} )
	ENDIF
	RETURN

NEW METHOD MouseWheel( args PARAMS USUAL[] ) AS VOID
	IF SELF:_VFPMouseWheel != NULL
		SELF:__aeventsData := AEventsDefinition{ SELF, "MouseWheel" }
		SELF:_VFPMouseWheel:Call( args )
	ENDIF


PRIVATE _VFPMessage AS VFPOverride
/// <summary>
/// Name of the VFP method called when the mouse enters the control; typically used to update status-bar text.
/// </summary>
[System.ComponentModel.Category("VFP Events"),System.ComponentModel.Description("Occurs when the mouse pointer moves over a control; used to display StatusBarText.")];
[System.ComponentModel.DefaultValue(NULL)];
PROPERTY vfpMessage AS STRING GET _VFPMessage?:SendTo SET Set_Message( VFPOverride{SELF, VALUE} )

METHOD Set_Message( methodCall AS VFPOverride ) AS VOID
	SUPER:MouseEnter += System.EventHandler{ SELF, @OnVFPMessage() }
	SELF:_VFPMessage := methodCall

PRIVATE METHOD OnVFPMessage(sender AS OBJECT, e AS System.EventArgs) AS VOID
	IF SELF:_VFPMessage != NULL
		SELF:__aeventsData := AEventsDefinition{ sender, "Message" }
		SELF:_VFPMessage:Call()
	ENDIF
	RETURN

METHOD Message() AS VOID
	SELF:OnVFPMessage( SELF, EventArgs.Empty )


PRIVATE _VFPKeyPress AS VFPOverride
/// <summary>
/// Name of the VFP method called when the user presses a character key while the control has focus. Called from the control's <c>OnKeyPress</c> override.
/// </summary>
[System.ComponentModel.Category("VFP Events"),System.ComponentModel.Description("KeyPress")];
[System.ComponentModel.DefaultValue(NULL)];
PROPERTY vfpKeyPress AS STRING GET _VFPKeyPress?:SendTo SET Set_KeyPress( VFPOverride{SELF, VALUE} )

METHOD Set_KeyPress( methodCall AS VFPOverride ) AS VOID
	SELF:_VFPKeyPress := methodCall

PRIVATE METHOD OnVFPKeyPress( sender AS OBJECT, e AS System.Windows.Forms.KeyPressEventArgs) AS VOID
	//
    IF SELF:_VFPKeyPress != NULL
        SELF:__aeventsData := AEventsDefinition{ sender, "KeyPress" }
		SELF:_VFPKeyPress:Call( )
    ENDIF

NEW METHOD KeyPress( args PARAMS USUAL[] ) AS VOID
	IF SELF:_VFPKeyPress != NULL
		SELF:__aeventsData := AEventsDefinition{ SELF, "KeyPress" }
		SELF:_VFPKeyPress:Call( args )
	ENDIF


PRIVATE _VFPKeyDown AS VFPOverride
/// <summary>
/// Name of the VFP method called when a key is pressed down. Passes nKeyCode, nShiftAltCtrl (bit 1=Shift, 2=Ctrl, 4=Alt).
/// </summary>
[System.ComponentModel.Category("VFP Events"),System.ComponentModel.Description("KeyDown")];
[System.ComponentModel.DefaultValue(NULL)];
PROPERTY vfpKeyDown AS STRING GET _VFPKeyDown?:SendTo SET Set_KeyDown( VFPOverride{SELF, VALUE} )

METHOD Set_KeyDown( methodCall AS VFPOverride ) AS VOID
    SUPER:KeyDown += System.Windows.Forms.KeyEventHandler{ SELF, @OnVFPKeyDown() }
    SELF:_VFPKeyDown := methodCall

PRIVATE METHOD OnVFPKeyDown( sender AS OBJECT, e AS System.Windows.Forms.KeyEventArgs) AS VOID
    IF SELF:_VFPKeyDown != NULL
        LOCAL nShift AS INT
        nShift := 0
        IF e:Shift   ; nShift += 1 ; ENDIF
        IF e:Control ; nShift += 2 ; ENDIF
        IF e:Alt     ; nShift += 4 ; ENDIF
        SELF:__aeventsData := AEventsDefinition{ sender, "KeyDown" }
        SELF:_VFPKeyDown:Call( <USUAL>{ (INT)e:KeyValue, nShift } )
    ENDIF

NEW METHOD KeyDown( args PARAMS USUAL[] ) AS VOID
	IF SELF:_VFPKeyDown != NULL
		SELF:__aeventsData := AEventsDefinition{ SELF, "KeyDown" }
		SELF:_VFPKeyDown:Call( args )
	ENDIF


PRIVATE _VFPKeyUp AS VFPOverride
/// <summary>
/// Name of the VFP method called when a key is released. Passes nKeyCode, nShiftAltCtrl (bit 1=Shift, 2=Ctrl, 4=Alt).
/// </summary>
[System.ComponentModel.Category("VFP Events"),System.ComponentModel.Description("KeyUp")];
[System.ComponentModel.DefaultValue(NULL)];
PROPERTY vfpKeyUp AS STRING GET _VFPKeyUp?:SendTo SET Set_KeyUp( VFPOverride{SELF, VALUE} )

METHOD Set_KeyUp( methodCall AS VFPOverride ) AS VOID
    SUPER:KeyUp += System.Windows.Forms.KeyEventHandler{ SELF, @OnVFPKeyUp() }
    SELF:_VFPKeyUp := methodCall

PRIVATE METHOD OnVFPKeyUp( sender AS OBJECT, e AS System.Windows.Forms.KeyEventArgs) AS VOID
    IF SELF:_VFPKeyUp != NULL
        LOCAL nShift AS INT
        nShift := 0
        IF e:Shift   ; nShift += 1 ; ENDIF
        IF e:Control ; nShift += 2 ; ENDIF
        IF e:Alt     ; nShift += 4 ; ENDIF
        SELF:__aeventsData := AEventsDefinition{ sender, "KeyUp" }
        SELF:_VFPKeyUp:Call( <USUAL>{ (INT)e:KeyValue, nShift } )
    ENDIF

NEW METHOD KeyUp( args PARAMS USUAL[] ) AS VOID
	IF SELF:_VFPKeyUp != NULL
		SELF:__aeventsData := AEventsDefinition{ SELF, "KeyUp" }
		SELF:_VFPKeyUp:Call( args )
	ENDIF


PRIVATE _VFPRefresh AS VFPOverride
/// <summary>
/// Name of the VFP method called when the control's <c>Refresh()</c> is invoked. Stored and called by the owning container's <c>Refresh</c> override.
/// </summary>
[System.ComponentModel.Category("VFP Properties"),System.ComponentModel.Description("Get/Set if the Refresh Method")];
[System.ComponentModel.DefaultValue(NULL)];
PROPERTY vfpRefresh AS STRING GET _VFPRefresh?:SendTo SET Set_Refresh( VFPOverride{SELF, VALUE} )

METHOD Set_Refresh( methodCall AS VFPOverride ) AS VOID
	// Set it, but don't attached it to the event
	// In VFPForm, the Refresh() method will do the job
	SELF:_VFPRefresh := methodCall
