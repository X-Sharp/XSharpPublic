<topic template="Default" modified="2026-11-17T13:30:54.276+01:00" lasteditedby="robert" version="2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../helpproject.xsd">
  <title>SET MARGIN 命令</title>
  <keywords>
    <keyword>Commands</keyword>
    <keyword>SET commands</keyword>
    <keyword>SET MARGIN command</keyword>
  </keywords>
  <body>
    <header>
      <para styleclass="Heading1">SET MARGIN 命令</para>
    </header>
    <para styleclass="Normal"><snippet src="__CommandInclude" inline="false"/></para>
    <para styleclass="Heading1">用途</para>
    <para styleclass="Normal">设置打印输出的左边距。</para>
    <para styleclass="Heading1">语法</para>
    <para styleclass="Code with box">SET MARGIN TO [&lt;nColumns&gt;]</para>
    <para styleclass="Heading1">参数</para>
    <para styleclass="List">&lt;nColumns&gt;<tab/>边距的列数。省略该值时，边距设置为 0。</para>
    <para styleclass="Body Text"><snippet src="__IncludeLibRT" inline="false"/></para>
    <para styleclass="Heading1">参见</para>
    <para styleclass="Normal"><link displaytype="text" defaultstyle="true" type="topiclink" href="command_SET_PRINTER">SET PRINTER</link></para>
  </body>
</topic>
