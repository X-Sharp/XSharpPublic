<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Runtime.Sdk.Props" />
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>XSharp.VO</RootNamespace>
    <AssemblyName>XSharp.VO</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <Dialect>VO</Dialect>
    <Unsafe>True</Unsafe>
    <NamedArgs>True</NamedArgs>
    <Cs>true</Cs>
    <StartupObject />
    <TargetFrameworks>net462;net8.0-windows</TargetFrameworks> 
    <Vo15>true</Vo15>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <TreatWarningsAsErrors>False</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RuntimeDir)XSharp.Core\XSharp.Core.Next.xsproj" />
    <ProjectReference Include="$(RuntimeDir)XSharp.RT\XSharp.RT.Next.xsproj" />
  </ItemGroup>
  <Import Project="..\XmlDoc.Props" />
</Project>