PRIVATE _VFPMouseUp AS VFPOverride
/// <summary>
/// Name of the VFP method called when a mouse button is released over the control. Passes nButton, nShift, nXCoord, nYCoord. Also triggers <see cref="vfpRightCLick"/> or <see cref="vfpMiddleClick"/> when applicable.
/// </summary>
[System.ComponentModel.Category("VFP Events"),System.ComponentModel.Description("MouseUp")];
[System.ComponentModel.DefaultValue(NULL)];
PROPERTY vfpMouseUp AS STRING GET _VFPMouseUp?:SendTo SET Set_MouseUp( VFPOverride{SELF, VALUE} )

METHOD Set_MouseUp( methodCall AS VFPOverride ) AS VOID
	SUPER:MouseUp += System.Windows.Forms.MouseEventHandler{ SELF, @OnVFPMouseUp() }
	SELF:_VFPMouseUp := methodCall

PRIVATE METHOD OnVFPMouseUp(sender AS OBJECT, e AS System.Windows.Forms.MouseEventArgs) AS VOID
	IF _VFPMouseUp != NULL
		LOCAL nButton AS INT
		LOCAL nShift AS INT
		LOCAL nXCoord AS INT
		LOCAL nYCoord AS INT
		//
		nXCoord := e:X - SELF:Location:X
		nYCoord := e:Y - SELF:Location:Y
		SWITCH e:Button
		CASE MouseButtons.Right
			nButton := 2
		CASE MouseButtons.Middle
			nButton := 4
		OTHERWISE
			nButton := 1
		END SWITCH
		nShift := 0
		IF ( System.Windows.Forms.Control.ModifierKeys & Keys.Shift ) == Keys.Shift
			nShift += 1
		ENDIF
		IF ( System.Windows.Forms.Control.ModifierKeys & Keys.Control ) == Keys.Control
			nShift += 2
		ENDIF
		IF ( System.Windows.Forms.Control.ModifierKeys & Keys.Alt ) == Keys.Alt
			nShift += 4
		ENDIF
		//
		SELF:__aeventsData := AEventsDefinition{ sender, "MouseUp" }
        SELF:_VFPMouseUp:Call( <USUAL>{nButton, nShift, nXCoord, nYCoord} )
        //
        IF (e:Button == MouseButtons.Right )
            SELF:OnVFPRightClick( sender, e )
        ENDIF
        IF (e:Button == MouseButtons.Middle )
            SELF:OnVFPMiddleClick( sender, e )
        ENDIF
	ENDIF
    RETURN

// Callable PEM: forwards the supplied nButton/nShift/nXCoord/nYCoord args directly —
// unlike the real mouse event, RightClick/MiddleClick chaining does not apply here.
NEW METHOD MouseUp( args PARAMS USUAL[] ) AS VOID
	IF SELF:_VFPMouseUp != NULL
		SELF:__aeventsData := AEventsDefinition{ SELF, "MouseUp" }
		SELF:_VFPMouseUp:Call( args )
	ENDIF

