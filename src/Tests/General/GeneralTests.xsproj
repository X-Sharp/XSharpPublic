<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ConsoleApplication2</RootNamespace>
    <TargetFramework>net47</TargetFramework>
    <Name>GeneralTests</Name>
    <Dialect>VO</Dialect>
    <VulcanCompatibleResources>False</VulcanCompatibleResources>
    <NoWin32Manifest>True</NoWin32Manifest>
    <VO1>false</VO1>
    <VO2>false</VO2>
    <VO3>false</VO3>
    <VO4>false</VO4>
    <VO5>false</VO5>
    <VO6>False</VO6>
    <VO7>True</VO7>
    <VO8>false</VO8>
    <VO9>False</VO9>
    <VO10>false</VO10>
    <VO11>false</VO11>
    <VO12>false</VO12>
    <VO13>false</VO13>
    <VO14>False</VO14>
    <VO15>True</VO15>
    <VO16>false</VO16>
    <AZ>false</AZ>
    <CS>false</CS>
    <LB>True</LB>
    <NamedArgs>false</NamedArgs>
    <OVF>false</OVF>
    <Unsafe>True</Unsafe>
    <INS>True</INS>
    <NS>false</NS>
    <NoStandardDefs>false</NoStandardDefs>
    <MemVar>True</MemVar>
    <Undeclared>False</Undeclared>
    <InitLocals>false</InitLocals>
    <AllowOldStyleAssignments>true</AllowOldStyleAssignments>
    <Allowdot>false</Allowdot>
    <AssemblyName>GeneralTests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Runtime\XSharp.Core\XSharp.Core.xsproj" />
    <ProjectReference Include="..\..\Runtime\XSharp.Rdd\XSharp.RDD.xsproj" />
    <ProjectReference Include="..\..\Runtime\XSharp.RT\XSharp.RT.xsproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <PlatformTarget>x86</PlatformTarget>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <TreatWarningsAsErrors>False</TreatWarningsAsErrors>
    <PPO>False</PPO>
    <Prefer32Bit>False</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <PlatformTarget>x86</PlatformTarget>
    <DefineConstants>TRACE</DefineConstants>
    <DebuggerCommandArguments>/args</DebuggerCommandArguments>
    <TreatWarningsAsErrors>False</TreatWarningsAsErrors>
    <Prefer32Bit>False</Prefer32Bit>
  </PropertyGroup>
</Project>