<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\VOSDK.SDK.Props" />
  <!-- Please note that most important settings are read from VOSDK.Props -->
  <PropertyGroup>
    <Description>XSharp Typed VO GUI Classes</Description>
    <Dialect>Vulcan</Dialect>
    <UseWindowsForms>true</UseWindowsForms>
    <Name>XSharp.VO.VOGUIClasses</Name>
    <NS>true</NS>
    <Ins>true</Ins>
    <VO7>True</VO7>
    <VO14>False</VO14>
    <vo15>true</vo15>
    <EnforceSelf>true</EnforceSelf>
    <TargetFrameworks>net47;net8.0-windows</TargetFrameworks>
    <AZ>false</AZ>
    <CS>False</CS>
    <!-- Note that there are a lot of locals that are not initialized.
        This takes care of that but of course costs a little performance.-->
    <InitLocals>true</InitLocals>
    <AssemblyName>XSharp.VOGuiClasses</AssemblyName>
    <RootNamespace>XSharp.VO.SDK</RootNamespace>
   </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Properties\AssemblyInfo.prg" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\XSharp.Core\XSharp.Core.xsproj" />
    <ProjectReference Include="..\..\..\..\XSharp.RT\XSharp.RT.xsproj" />
    <ProjectReference Include="..\..\..\..\XSharp.VO\XSharp.VO.xsproj" />
    <ProjectReference Include="..\System_Classes_SDK\XSharp.VO.SystemClasses.xsproj" />
  </ItemGroup>
  <Import Project="..\VOSDKDocs.Props" />
</Project>