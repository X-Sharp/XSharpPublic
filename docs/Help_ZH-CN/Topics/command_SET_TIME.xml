<topic template="Default" modified="2026-11-17T13:30:54.046+01:00" lasteditedby="robert" version="2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../helpproject.xsd">
  <title>SET TIME 命令</title>
  <keywords>
    <keyword>Commands</keyword>
    <keyword>SET commands</keyword>
    <keyword>SET TIME command</keyword>
  </keywords>
  <body>
    <header>
      <para styleclass="Heading1">SET TIME 命令</para>
    </header>
    <para styleclass="Normal"><snippet src="__CommandInclude" inline="false"/></para>
    <para styleclass="Heading1">用途</para>
    <para styleclass="Normal">指定用于显示时间值的格式。</para>
    <para styleclass="Heading1">语法</para>
    <para styleclass="Code with box">SET TIME TO &lt;cTimeFormat&gt;<br/>SET TIME TO SYSTEM</para>
    <para styleclass="Heading1">参数</para>
    <para styleclass="List">&lt;cTimeFormat&gt;<tab/>时间格式，例如 HH:MM:SS。格式可以带引号，也可以不带引号。</para>
    <para styleclass="List">SYSTEM<tab/>使用操作系统的时间格式。</para>
    <para styleclass="Heading1">备注</para>
    <para styleclass="Normal">该命令等同于函数 <link displaytype="text" defaultstyle="true" type="topiclink" href="html\M_XSharp_Core_Functions_SetTimeFormat.htm" domain="XSharpRef.chm">SetTimeFormat()</link>。</para>
    <para styleclass="Body Text"><snippet src="__IncludeLibRT" inline="false"/></para>
    <para styleclass="Heading1">参见</para>
    <para styleclass="Normal"><link displaytype="text" defaultstyle="true" type="topiclink" href="command_SET_HOURS">SET HOURS</link>, <link displaytype="text" defaultstyle="true" type="topiclink" href="command_SET_SECONDS">SET SECONDS</link>, <link displaytype="text" defaultstyle="true" type="topiclink" href="command_SET_DATE_FORMAT">SET DATE FORMAT</link>, <link displaytype="text" defaultstyle="true" type="topiclink" href="html\M_XSharp_Core_Functions_SetTimeFormat.htm" domain="XSharpRef.chm">SetTimeFormat()</link></para>
  </body>
</topic>
