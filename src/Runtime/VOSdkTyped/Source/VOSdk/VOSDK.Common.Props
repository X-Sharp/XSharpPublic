<?xml version="1.0" encoding="utf-8"?>
<Project>
<Import Project="..\..\..\..\Shared.Props" />
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <OutputType>Library</OutputType>
    <RootNamespace>VO</RootNamespace>
    <TargetFrameworkVersion>v4.6</TargetFrameworkVersion>
    <TargetFrameworkProfile />
    <Nostandarddefs>True</Nostandarddefs>
    <SignAssembly>true</SignAssembly>
    <DelaySign>false</DelaySign>
    <Prefer32Bit>False</Prefer32Bit>
    <CommandLineOption />
    <WarningLevel>4</WarningLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <VulcanCompatibleResources>True</VulcanCompatibleResources>
    <CS>true</CS>
    <Unsafe>true</Unsafe>
    <INS>true</INS>
    <NS>true</NS>
    <VO2>true</VO2>
    <VO3>true</VO3>
    <VO4>false</VO4>
    <vo5>false</vo5>
    <VO6>false</VO6>
    <VO7>false</VO7>
    <VO8>false</VO8>
    <VO9>false</VO9>
    <VO10>false</VO10>
    <VO11>true</VO11>
    <VO14>true</VO14>
    <vo15>true</vo15>
    <IncludePaths>$(CommonDir)</IncludePaths>
    <UseSharedCompilation>true</UseSharedCompilation>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
<PropertyGroup Condition="$(Configuration.Contains('Doc'))" >
    <DocumentationFile>$(AssemblyName).Xml</DocumentationFile>
    <EmitDebugInformation>true</EmitDebugInformation>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE;DOCUMENTATION;RUNTIME</DefineConstants>
    <NoWarn>$(DisabledWarnings);$(NoWarn);1591,9015,169,649</NoWarn>
    <CommandLineOption>/noclipcall</CommandLineOption>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'" >
    <DefineConstants>TRACE;RUNTIME;$(DefineConstants)</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'" >
    <DefineConstants>DEBUG;TRACE;RUNTIME;$(DefineConstants)</DefineConstants>
  </PropertyGroup>
</Project>