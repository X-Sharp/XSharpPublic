<topic template="Default" modified="2026-11-17T12:00:00.000+01:00" lasteditedby="Copilot" version="2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../helpproject.xsd">
  <title>SET CURSOR Command</title>
  <keywords>
    <keyword>Commands</keyword>
    <keyword>SET commands</keyword>
    <keyword>SET CURSOR command</keyword>
  </keywords>
  <body>
    <header>
      <para styleclass="Heading1">SET CURSOR Command</para>
    </header>
    <para styleclass="Normal"><snippet src="__FoxProOnly" inline="false"/></para>
    <para styleclass="Normal"><snippet src="__CommandInclude" inline="false"/></para>
    <para styleclass="Heading1">Purpose</para>
    <para styleclass="Normal">Specifies whether the cursor is displayed while the program waits for input.</para>
    <para styleclass="Heading1">Syntax</para>
    <para styleclass="Code with box">SET CURSOR ON | OFF | &amp;&lt;cMacro&gt;</para>
    <para styleclass="Heading1">Arguments</para>
    <para styleclass="List">ON | OFF<tab />ON shows the cursor, OFF hides the cursor. The value may also be a macro (&amp;) that evaluates to ON or OFF.</para>
    <para styleclass="Heading1">Remarks</para>
    <para styleclass="Normal">The setting is stored in the runtime state, but the runtime does not use it at this moment.</para>
    <para styleclass="Body Text"><snippet src="__IncludeLibVFP" inline="false"/></para>
    <para styleclass="Heading1">See Also</para>
    <para styleclass="Normal"><link displaytype="text" defaultstyle="true" type="topiclink" href="command_SET_CONFIRM">SET CONFIRM</link>, <link displaytype="text" defaultstyle="true" type="topiclink" href="command_SET_ESCAPE">SET ESCAPE</link></para>
  </body>
</topic>
