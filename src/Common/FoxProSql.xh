#ifndef FOXPROSQL_XH
#define FOXPROSQL_XH


#command __NOFOXPROSQL__ <any> => #error This Embedded SQL command is not (yet) supported: <(any)>

// DDL Commands

// SQL Alter Commands
#command ALTER TABLE <*clauses*>                            => __SqlAlterTable(<"udc">)
#command ALTER TABLE <*clauses*> [COLUMN]  <*moreclause*>   => __SqlAlterTable(<"udc">)

// SQL Create Commands
#command CREATE <tbl:TABLE,DBF> <*clauses*>                 => __SqlCreateTable(<"udc">)
#command CREATE CURSOR <*clauses*>                          => __SqlCreateCursor(<"udc">)
#command CREATE [SQL] VIEW <*clauses*>                     => __SqlCreateView(<"udc">)

// SQL Drop Commands
#command DROP TABLE <(table)>                               => __SqlDropTable(<"table">)
#command DROP VIEW <(view)>                                => __SqlDropView(<"view">)


// DML Commands

// SQL Insert commands
// First is generic INSERT, to enable keyword coloring  while typing

#command INSERT [INTO] [<*any*>] => #error <(udc)> : Missing FROM or VALUES clause

#command INSERT INTO <(table)> FROM MEMVAR => ;
    __SqlInsertMemVar(<"table"> )

#command INSERT INTO <(table)> [( <(f1)> [, <(fn)> ] )]  VALUES (  <(v1)> [, <(vn)> ] )     => ;
    __SqlInsertValues(<"table"> , { <"f1"> [, <"fn"> ] },  { <v1> [, <vn> ] } )

#command INSERT INTO <(table)>  FROM ARRAY <ArrayName>   => ;
    __SqlInsertFromArray( <"table">,  <ArrayName>)

#command INSERT INTO <(table)> FROM NAME <ObjectName>   => ;
    __SqlInsertFromObject(<"table"> , <ObjectName> )

#command INSERT INTO <(table)> [( <(f1)> [, <(fn)> ] )] <s:SELECT> <*moreclauses*>   => ;
    __SqlInsertFromSQL(<"udc">, <"table"> , { <"f1"> [, <"fn"> ] },  <"s">+" "+<"moreclauses"> )

// SQL Delete, mapped to normal delete. DELETE - SQL always works on the whole
// table, so the scope is ALL: without the WHERE clause every record is deleted,
// with it every record that matches. Without ALL, DELETE FROM <table> would fall
// into the single record DELETE IN <table> rule and delete the current record only.
// ALL goes after the FOR clause because the scoped DELETE ... IN rule does not
// accept it in front of FOR. _TALLY counts the rows that matched, the already
// deleted ones included.
#command DELETE [<*clauses*>] WHERE [<*moreclauses*>] => DELETE <clauses> FOR <moreclauses>
#command DELETE <*target*> FROM <(a)> [<*clauses*>] => DELETE <clauses> ALL IN <target> ; _TALLY := RuntimeState.Tally
#command DELETE FROM <(a)> [<*clauses*>] => DELETE <clauses> ALL IN <a> ; _TALLY := RuntimeState.Tally

// VFP joins DELETE sources with a comma-separated table list and a WHERE clause.
#command DELETE <*target*> FROM <(a)> , <*moretables*> WHERE <*whereclause*> => __SqlDelete(<"udc">)

// DELETE predicates with subqueries use the embedded SQL evaluator.
#command DELETE [<*clauses*>] <s:SELECT> <*moreclauses*> => __SqlDelete(<"udc">)

// Explicit JOIN syntax is not accepted by VFP9 for DELETE.
#command DELETE [<*clauses*>] JOIN <*moreclauses*> => __NOFOXPROSQL__ <(udc)>

#command UPDATE <(a)> SET <(f1)> = <x1> [, <(fn)> = <xn>]               ;
         [WHERE <lfor>]                                                   ;
      => (<(a)>)->(DbEval(                                              ;
                 {||DbAutoLock(), __FieldSet(<(f1)>,<x1>) [, __FieldSet(<(fn)>, <xn>)], DbAutoUnLock()},    ;
                 <{lfor}>))

// Single-source UPDATE ... FROM, handled by the embedded SQL runtime.
#command UPDATE <*tableName*> SET <*setclauses*> FROM <*fromclause*> [WHERE <*whereclause*>] => __SqlUpdate(<"udc">)

// Update with Join or Subselect is not supported
#command UPDATE [<*clauses*>] <x:SELECT,JOIN> <*moreclauses*> => __NOFOXPROSQL__ <(udc)>


// SQL Select command
#command SELECT <*selectbeforefrom*> FROM <*selectafterfrom*> => __SqlSelect(<"udc">)

   #endif
// EOF
