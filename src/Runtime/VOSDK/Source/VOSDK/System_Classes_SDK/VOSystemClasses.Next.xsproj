<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\VOSDK.SDK.Props" />
  <PropertyGroup>
    <AssemblyName>VOSystemClasses</AssemblyName>
    <cs>True</cs>
    <EnforceSelf>True</EnforceSelf>
    <TargetFrameworks>net462;net8.0</TargetFrameworks>
    <Dialect>XbaseNet</Dialect>
    <NoWarn>Nu1702;$(NoWarn)</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RuntimeDir)XSharp.Core\XSharp.Core.Next.xsproj" />
    <ProjectReference Include="$(RuntimeDir)XSharp.RT\XSharp.RT.Next.xsproj" />
    <ProjectReference Include="$(RuntimeDir)XSharp.VO\XSharp.VO.Next.xsproj" />
  </ItemGroup>
</Project>