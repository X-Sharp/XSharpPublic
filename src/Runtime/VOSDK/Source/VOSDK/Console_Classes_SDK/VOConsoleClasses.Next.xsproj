<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\VOSDK.SDK.Props" />
  <PropertyGroup>
    <AssemblyName>VOConsoleClasses</AssemblyName>
    <EnforceSelf>True</EnforceSelf>
    <TargetFrameworks>net462;net8.0</TargetFrameworks>
    <Dialect>XbaseNet</Dialect>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RuntimeDir)XSharp.Core\XSharp.Core.Next.xsproj" />
    <ProjectReference Include="$(RuntimeDir)XSharp.RT\XSharp.RT.Next.xsproj" />  </ItemGroup>
</Project>