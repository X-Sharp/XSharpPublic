<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="..\VisualStudio\Common.props" />
  <Import Project="$(Commondir)Version.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Ns>true</Ns>
    <ApplicationIcon>$(Commondir)XSharp.ico</ApplicationIcon>
    <TargetFramework>net47</TargetFramework>
    <NoStandardDefs>true</NoStandardDefs>
    <IncludePaths>$(Solutiondir)Common</IncludePaths>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
</Project>
