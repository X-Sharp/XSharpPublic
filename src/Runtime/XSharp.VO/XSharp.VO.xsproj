<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Runtime.Sdk.Props" />
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>XSharp.VO</RootNamespace>
    <AssemblyName>XSharp.VO</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <Dialect>VO</Dialect>
    <Unsafe>True</Unsafe>
    <NamedArgs>True</NamedArgs>
    <Cs>true</Cs>
    <StartupObject /> 
    <Vo15>true</Vo15> 
    <ActiveTargetFramework>net47</ActiveTargetFramework> 
    <TargetFrameworks>net47;net8.0-windows</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <TreatWarningsAsErrors>False</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\XSharp.Core\XSharp.Core.xsproj" />
    <ProjectReference Include="..\XSharp.RT\XSharp.RT.xsproj" />
  </ItemGroup>
  <Import Project="..\XmlDoc.Props" />
</Project>