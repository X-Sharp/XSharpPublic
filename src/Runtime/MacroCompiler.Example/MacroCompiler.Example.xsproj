<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Runtime.Sdk.Props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>MacroCompilerTest</RootNamespace>
    <AssemblyName>MacroCompilerTest</AssemblyName>
    <Name>MacroCompiler.Example.Next</Name>
    <Dialect>VO</Dialect>
    <LB>true</LB>
    <VO15>true</VO15>
    <Memvar>true</Memvar>
    <AllowOldStyleAssignments>true</AllowOldStyleAssignments>
    <NoStandardDefs>false</NoStandardDefs>
    <TargetFrameworks>net47;net8.0</TargetFrameworks>
    <!--The following is needed because XSharp.VO uses Windows.Forms-->
    <NoWarn>Nu1702;$(NoWarn)</NoWarn>
    <Unsafe>true</Unsafe>
    <CS>False</CS>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MacroCompiler\XSharp.MacroCompiler.csproj" />
    <ProjectReference Include="..\XSharp.Core\XSharp.Core.xsproj" />
    <ProjectReference Include="..\XSharp.Data\XSharp.Data.xsproj" />
    <ProjectReference Include="..\XSharp.RT\XSharp.RT.xsproj" />
    <ProjectReference Include="..\XSharp.VFP\XSharp.VFP.xsproj" />
    <ProjectReference Include="..\XSharp.VO\XSharp.VO.xsproj" />
  </ItemGroup>
</Project>