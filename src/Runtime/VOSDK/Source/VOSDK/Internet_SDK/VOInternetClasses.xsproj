<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\VOSDK.SDK.Props" />
  <PropertyGroup>
    <AssemblyName>VOInternetClasses</AssemblyName>
    <TargetFramework>net47</TargetFramework>
    <Dialect>Vo</Dialect>
    <VO15>true</VO15>
    <unsafe>True</unsafe>
    <ins>true</ins>
    <VO3>True</VO3>
    <VO9>True</VO9>
    <Ns>True</Ns>
    <CS>False</CS>
  </PropertyGroup>
 <ItemGroup>
    <ProjectReference Include="$(RuntimeDir)XSharp.Core\XSharp.Core.xsproj" />

    <ProjectReference Include="$(RuntimeDir)XSharp.RT\XSharp.RT.xsproj"/>

    <ProjectReference Include="$(RuntimeDir)XSharp.VO\XSharp.VO.xsproj" />
    <ProjectReference Include="..\System_Classes_SDK\VOSystemClasses.xsproj" />

    <ProjectReference Include="..\Win32_API_Library_SDK\VOWin32APILibrary.xsproj" />
  </ItemGroup>
  <Import Project="..\VOSDKDocs.Props" />
</Project>