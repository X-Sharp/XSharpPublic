<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ConsoleApplication1</RootNamespace>
    <TargetFramework>net472</TargetFramework>
    <Name>FoxTest</Name>
    <Dialect>FoxPro</Dialect>
    <vo15>True</vo15>
    <AZ>false</AZ>
    <CS>false</CS>
    <LB>True</LB>
    <NamedArgs>False</NamedArgs>
    <OVF>false</OVF>
    <Unsafe>false</Unsafe>
    <INS>true</INS>
    <NS>false</NS>
    <NoStandardDefs>False</NoStandardDefs>
    <MemVar>True</MemVar>
    <Undeclared>True</Undeclared>
    <InitLocals>false</InitLocals>
    <VulcanCompatibleResources>False</VulcanCompatibleResources>
    <NoWin32Manifest>False</NoWin32Manifest>
    <Vo2>True</Vo2>
    <Vo9>True</Vo9>
    <Allowdot>true</Allowdot>
    <AllowOldStyleAssignments>True</AllowOldStyleAssignments>
    <Fox1>true</Fox1>
    <AssemblyName>ConsoleApplication1</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Runtime\XSharp.Core\XSharp.Core.xsproj" />
    <ProjectReference Include="..\..\Runtime\XSharp.Rdd\XSharp.RDD.xsproj" />
    <ProjectReference Include="..\..\Runtime\XSharp.RT\XSharp.RT.xsproj" />
    <ProjectReference Include="..\..\Runtime\XSharp.VFP\XSharp.VFP.xsproj" />
    <ProjectReference Include="..\..\Runtime\XSharp.XPP\XSharp.XPP.xsproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="obj\Debug\" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <TreatWarningsAsErrors>False</TreatWarningsAsErrors>
    <PPO>True</PPO>
    <Prefer32Bit>True</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DefineConstants>TRACE</DefineConstants>
    <TreatWarningsAsErrors>False</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>