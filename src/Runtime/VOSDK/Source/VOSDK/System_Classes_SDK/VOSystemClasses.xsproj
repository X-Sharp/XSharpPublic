<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\VOSDK.SDK.Props" />
  <PropertyGroup>
    <AssemblyName>VOSystemClasses</AssemblyName>
    <cs>True</cs>
    <EnforceSelf>True</EnforceSelf>
    <TargetFrameworks>net47;net8.0</TargetFrameworks>
    <Dialect>XbaseNet</Dialect>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RuntimeDir)XSharp.Core\XSharp.Core.xsproj" />
    <ProjectReference Include="$(RuntimeDir)XSharp.RT\XSharp.RT.xsproj" />
  </ItemGroup>
    <Import Project="..\VOSDKDocs.Props" />

</Project>