<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ConsoleApplication1</RootNamespace>
    <TargetFramework>net47</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Name>FoxSqlTest</Name>
    <Dialect>FoxPro</Dialect>
    <az>false</az>
    <ins>true</ins>
    <unsafe>true</unsafe>
    <vo2>true</vo2>
    <vo3>true</vo3>
    <vo4>true</vo4>
    <vo5>true</vo5>
    <vo6>true</vo6>
    <vo7>true</vo7>
    <vo9>true</vo9>
    <vo10>true</vo10>
    <vo13>true</vo13>
    <vo14>true</vo14>
    <vo15>true</vo15>
    <vo16>true</vo16>
    <lb>true</lb>
    <memvar>True</memvar>
    <undeclared>False</undeclared>
    <initlocals>true</initlocals>
    <fox1>true</fox1>
    <CS>false</CS>
    <NamedArgs>false</NamedArgs>
    <OVF>false</OVF>
    <NS>false</NS>
    <NoStandardDefs>false</NoStandardDefs>
    <VulcanCompatibleResources>False</VulcanCompatibleResources>
    <NoWin32Manifest>False</NoWin32Manifest>
    <Allowdot>True</Allowdot>
    <AllowOldStyleAssignments>True</AllowOldStyleAssignments>
    <AssemblyName>ConsoleApplication1</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Runtime\XSharp.Core\XSharp.Core.xsproj" />
    <ProjectReference Include="..\..\Runtime\XSharp.Data\XSharp.Data.xsproj" />
    <ProjectReference Include="..\..\Runtime\XSharp.Rdd\XSharp.RDD.xsproj" />
    <ProjectReference Include="..\..\Runtime\XSharp.RT\XSharp.RT.xsproj" />
    <ProjectReference Include="..\..\Runtime\XSharp.VFP\XSharp.VFP.xsproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="obj\Debug\" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <PPO>false</PPO>
    <Prefer32Bit>True</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
</Project>