<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\VOSDK.SDK.Props" />
  <!-- Please note that most important settings are read from VOSDK.Props -->
  <PropertyGroup>
    <Description>XSharp Typed VO GUI Classes</Description>
    <Dialect>Vulcan</Dialect>
    <UseWindowsForms>true</UseWindowsForms>
    <Name>XSharp.VO.VOGUIClasses</Name>
    <NS>true</NS>
    <Ins>true</Ins>
    <vo15>true</vo15>
    <EnforceSelf>true</EnforceSelf>
    <TargetFrameworks>net462;net8.0-windows</TargetFrameworks>
    <NoWarn>165;168;NU1702;$(NoWarn)</NoWarn>
    <AZ>false</AZ>
    <VO7>True</VO7>
    <CS>False</CS>
    <VO14>False</VO14>
    <AssemblyName>XSharp.VOGuiClasses</AssemblyName>
    <RootNamespace>XSharp.VO.SDK</RootNamespace>
   </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Properties\AssemblyInfo.prg" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(RuntimeDir)XSharp.Core\XSharp.Core.Next.xsproj" />
    <ProjectReference Include="$(RuntimeDir)XSharp.RT\XSharp.RT.Next.xsproj" />
    <ProjectReference Include="$(RuntimeDir)XSharp.VO\XSharp.VO.Next.xsproj" />
    <ProjectReference Include="..\System_Classes_SDK\XSharp.VO.SystemClasses.Next.xsproj" />
  </ItemGroup>
  <Import Project="..\VOSDKDocs.Props" />
</Project>