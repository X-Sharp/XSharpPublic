<topic template="Default" modified="2026-11-17T13:30:54.036+01:00" lasteditedby="robert" version="2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../helpproject.xsd">
  <title>SET SECONDS 命令</title>
  <keywords>
    <keyword>Commands</keyword>
    <keyword>SET commands</keyword>
    <keyword>SET SECONDS command</keyword>
  </keywords>
  <body>
    <header>
      <para styleclass="Heading1">SET SECONDS 命令</para>
    </header>
    <para styleclass="Normal"><snippet src="__FoxProOnly" inline="false"/></para>
    <para styleclass="Normal"><snippet src="__CommandInclude" inline="false"/></para>
    <para styleclass="Heading1">用途</para>
    <para styleclass="Normal">指定是否在 DateTime 值的时间部分显示秒。</para>
    <para styleclass="Heading1">语法</para>
    <para styleclass="Code with box">SET SECONDS ON | OFF | &amp;&lt;cMacro&gt;</para>
    <para styleclass="Heading1">参数</para>
    <para styleclass="List">ON | OFF<tab/>ON 显示秒。OFF 不显示秒。该值也可以是一个宏（&amp;），其求值结果为 ON 或 OFF。</para>
    <para styleclass="Heading1">备注</para>
    <para styleclass="Normal">SET SECONDS 等同于函数 <link displaytype="text" defaultstyle="true" type="topiclink" href="html\Overload_XSharp_Core_Functions_SetSeconds.htm" domain="XSharpRef.chm">SetSeconds()</link>。</para>
    <para styleclass="Body Text"><snippet src="__IncludeLibVFP" inline="false"/></para>
    <para styleclass="Heading1">参见</para>
    <para styleclass="Normal"><link displaytype="text" defaultstyle="true" type="topiclink" href="command_SET_HOURS">SET HOURS</link>, <link displaytype="text" defaultstyle="true" type="topiclink" href="command_SET_TIME">SET TIME</link>, <link displaytype="text" defaultstyle="true" type="topiclink" href="html\Overload_XSharp_Core_Functions_SetSeconds.htm" domain="XSharpRef.chm">SetSeconds()</link></para>
  </body>
</topic>
