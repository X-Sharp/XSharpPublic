<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Runtime.Sdk.Props" />
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>XSharp.RT</RootNamespace>
    <AssemblyName>XSharp.RT</AssemblyName>
    <Dialect>XBaseNet</Dialect>
    <Unsafe>True</Unsafe>
    <NamedArgs>True</NamedArgs>
    <Vo15>true</Vo15>
    <TargetFrameworks>net47;net8.0</TargetFrameworks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Types\psznew.prg" />
    <Compile Include="$(CommonInclude)\Constants.prg" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\XSharp.Core\XSharp.Core.Next.xsproj" />
  </ItemGroup>
  <Import Project="..\XmlDoc.Props" />
</Project>